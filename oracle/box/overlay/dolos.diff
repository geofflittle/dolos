+/// Whether a planted arm decides from the supplied redeemers and script guards that phase two has no work.
+fn oracle_planted_skip(tx: &MultiEraTx<'_>) -> bool {
+    use pallas::ledger::primitives::dijkstra::{Guards, StakeCredential};
+
+    let script_guard = |guards: Option<&Guards>| {
+        matches!(guards, Some(Guards::Credentials(credentials)) if credentials
+            .iter()
+            .any(|credential| matches!(credential, StakeCredential::ScriptHash(_))))
+    };
+    let redeemers = !tx.redeemers().is_empty()
+        || tx.as_dijkstra().is_some_and(|tx| {
+            tx.transaction_body
+                .sub_transactions
+                .iter()
+                .flat_map(|subs| subs.iter())
+                .any(|sub| sub.transaction_witness_set.redeemer.is_some())
+        });
+    let guards = tx.as_dijkstra().is_some_and(|tx| {
+        script_guard(tx.transaction_body.guards.as_ref())
+            || tx
+                .transaction_body
+                .sub_transactions
+                .iter()
+                .flat_map(|subs| subs.iter())
+                .any(|sub| script_guard(sub.sub_transaction_body.guards.as_ref()))
+    });
+    (pallas::crypto::oracle_plant("requests-scripts-reverted") && !redeemers)
+        || (pallas::crypto::oracle_plant("missing-script-refusal-reverted") && !redeemers && !guards)
